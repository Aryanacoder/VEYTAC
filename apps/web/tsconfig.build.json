{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./static-build",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": ["src/perceive/events.test.ts", "src/perceive/overlay.test.ts", "src/perceive/node-test.d.ts"]
}
