{
  "name": "veytac-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "cert:lan": "python ../../scripts/generate_lan_cert.py",
    "dev:https": "vite --host 0.0.0.0 --port 5173 --strictPort --mode lan",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "smoke:chromium": "tsc -p tsconfig.build.json && node scripts/patch-static.mjs && node scripts/chromium-smoke.mjs",
    "test:perceive": "tsc -p tsconfig.perceive.json && node --test .tmp-perceive/events.test.js .tmp-perceive/overlay.test.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.20",
    "preact": "^11.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
