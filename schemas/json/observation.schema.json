{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "time_range",
        "document_page",
        "audio_span"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "relationship": {
          "$ref": "#/$defs/EvidenceRelationship",
          "default": "supports"
        },
        "alignment_uncertainty_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Uncertainty Ms"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRelationship": {
      "enum": [
        "supports",
        "contradicts",
        "context_only"
      ],
      "title": "EvidenceRelationship",
      "type": "string"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "clock_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Id"
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "region_xyxy_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Xyxy Normalized"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "ObservationStatus": {
      "enum": [
        "proposed",
        "confirmed",
        "unresolved"
      ],
      "title": "ObservationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "window_start_ms": {
      "title": "Window Start Ms",
      "type": "integer"
    },
    "window_end_ms": {
      "title": "Window End Ms",
      "type": "integer"
    },
    "description": {
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "objects": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Objects",
      "type": "array"
    },
    "candidate_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Action"
    },
    "observation_status": {
      "$ref": "#/$defs/ObservationStatus",
      "default": "proposed"
    },
    "uncertainty": {
      "default": "",
      "title": "Uncertainty",
      "type": "string"
    },
    "unavailable_cues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unavailable Cues",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "prompt_version": {
      "default": "",
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "window_start_ms",
    "window_end_ms",
    "description"
  ],
  "title": "Observation",
  "type": "object"
}
