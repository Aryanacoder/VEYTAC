{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "time_range",
        "document_page",
        "audio_span"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "relationship": {
          "$ref": "#/$defs/EvidenceRelationship",
          "default": "supports"
        },
        "alignment_uncertainty_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Uncertainty Ms"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRelationship": {
      "enum": [
        "supports",
        "contradicts",
        "context_only"
      ],
      "title": "EvidenceRelationship",
      "type": "string"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "clock_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Id"
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "region_xyxy_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Xyxy Normalized"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "rights": {
      "default": "private",
      "title": "Rights",
      "type": "string"
    },
    "derivation_lineage": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Derivation Lineage",
      "type": "array"
    },
    "available": {
      "default": true,
      "title": "Available",
      "type": "boolean"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "session_id",
    "origin",
    "sha256",
    "media_type"
  ],
  "title": "EvidenceAsset",
  "type": "object"
}
