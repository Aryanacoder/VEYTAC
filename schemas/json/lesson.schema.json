{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "time_range",
        "document_page",
        "audio_span"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "relationship": {
          "$ref": "#/$defs/EvidenceRelationship",
          "default": "supports"
        },
        "alignment_uncertainty_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Uncertainty Ms"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRelationship": {
      "enum": [
        "supports",
        "contradicts",
        "context_only"
      ],
      "title": "EvidenceRelationship",
      "type": "string"
    },
    "LessonCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "expected_distinction": {
          "title": "Expected Distinction",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "prompt",
        "expected_distinction",
        "explanation"
      ],
      "title": "LessonCheckpoint",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "clock_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Id"
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "region_xyxy_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Xyxy Normalized"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source_episode_id": {
      "title": "Source Episode Id",
      "type": "string"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "task_context": {
      "title": "Task Context",
      "type": "string"
    },
    "evidence_clip_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Clip Refs",
      "type": "array"
    },
    "checkpoints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LessonCheckpoint"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "diagram_provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagram Provenance"
    }
  },
  "required": [
    "id",
    "source_episode_id",
    "source_revision",
    "title",
    "task_context"
  ],
  "title": "Lesson",
  "type": "object"
}
