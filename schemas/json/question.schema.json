{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "time_range",
        "document_page",
        "audio_span"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "relationship": {
          "$ref": "#/$defs/EvidenceRelationship",
          "default": "supports"
        },
        "alignment_uncertainty_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Uncertainty Ms"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRelationship": {
      "enum": [
        "supports",
        "contradicts",
        "context_only"
      ],
      "title": "EvidenceRelationship",
      "type": "string"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "clock_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Id"
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "region_xyxy_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Xyxy Normalized"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "QuestionState": {
      "enum": [
        "candidate",
        "queued",
        "delivered",
        "answering",
        "answered",
        "incorporated",
        "rejected",
        "deferred",
        "skipped",
        "expired",
        "needs_clarification"
      ],
      "title": "QuestionState",
      "type": "string"
    },
    "QuestionType": {
      "enum": [
        "clarify_observation",
        "hidden_cue",
        "decision_boundary",
        "alternative",
        "exception",
        "verification"
      ],
      "title": "QuestionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "gap_id": {
      "title": "Gap Id",
      "type": "string"
    },
    "wording": {
      "title": "Wording",
      "type": "string"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "question_type": {
      "$ref": "#/$defs/QuestionType",
      "default": "clarify_observation"
    },
    "state": {
      "$ref": "#/$defs/QuestionState",
      "default": "candidate"
    },
    "rank_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank Score"
    },
    "rank_features": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "title": "Rank Features",
      "type": "object"
    },
    "rank_reason": {
      "default": "",
      "title": "Rank Reason",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "superseded_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded Reason"
    }
  },
  "required": [
    "id",
    "session_id",
    "gap_id",
    "wording"
  ],
  "title": "Question",
  "type": "object"
}
